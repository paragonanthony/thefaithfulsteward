# PostgreSQL connection string. On Railway, set to ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/npacct
# Set PGSSL=true when connecting over a public URL that requires TLS.
PGSSL=false
# Long random string used to sign session cookies (required in production).
SESSION_SECRET=change-me
# First system administrator, created on first start if none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
NODE_ENV=production
PORT=3000

# Live bank feeds (optional). See README "Live bank feeds (Plaid)".
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Long random string; encrypts stored secrets (bank and mailbox tokens). Do not change once connected.
ENCRYPTION_KEY=
# PLAID_WEBHOOK_URL=https://your-app.up.railway.app/api/plaid/webhook
# PLAID_REDIRECT_URI=https://your-app.up.railway.app/bank-feed/oauth

# Emailing receipts (optional). See README "Emailing receipts".
# EMAIL_PROVIDER=postmark            # smtp | sendgrid | postmark | resend | microsoft365
# EMAIL_FROM=receipts@yourdomain.org
# EMAIL_API_KEY=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# RECEIPT_EMAIL_DAILY_LIMIT=500

# Microsoft 365 (optional). See README "Microsoft 365".
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# M365_REDIRECT_URI=https://your-app.up.railway.app/api/m365/callback
# M365_TENANT_ID=                     # only for EMAIL_PROVIDER=microsoft365 (server-wide, app-only)
